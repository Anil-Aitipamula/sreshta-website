# Sreshta BFF
PORT=4001
CORS_ORIGIN=http://localhost:3000
# Database (Supabase PostgreSQL pooler or Neon)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Free Image Storage via Supabase Storage bucket (optional, falls back to local /uploads)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sreshta-assets

# Public URLs (redirects / thanks page / emails)
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:4001

# Cloud Run:
# CORS_ORIGIN=https://YOUR-FRONTEND.run.app
# PUBLIC_BASE_URL=https://YOUR-FRONTEND.run.app
# PUBLIC_API_BASE_URL=https://YOUR-BACKEND.run.app
# COOKIE_SECURE=true

# Customer order emails (Gmail app password or SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Sreshta Jewellers" <invoices@sreshtajewellers.com>

# Razorpay Standard Checkout (Orders API)
RAZORPAY_DISPLAY_NAME=Octis
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Google Sign-In
# GOOGLE_CLIENT_ID=
